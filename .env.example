# Salin file ini menjadi .env.local lalu isi dari Supabase:
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key

# Alamat website. Lokal: http://localhost:3000, produksi: URL Vercel kamu
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rahasia untuk job harian (Vercel Cron). Isi string acak panjang.
CRON_SECRET=ganti-dengan-string-acak

# HANYA di server (Vercel env), dipakai job harian. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key
